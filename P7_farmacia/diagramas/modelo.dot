digraph G {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.55, fontname="Helvetica", dpi=170, bgcolor="white"];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", color="#334155"];
  Contrato [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DBEAFE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Vendible</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+TASA_IMPUESTO: double</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+clave(): Sku</I><BR ALIGN="LEFT"/><I>+nombre(): String</I><BR ALIGN="LEFT"/><I>+precioBase(): double</I><BR ALIGN="LEFT"/><I>+tarifa(u: int): double</I><BR ALIGN="LEFT"/>+tarifaConImpuesto(u: int): double «default»<BR ALIGN="LEFT"/><U>+porNombre(): Comparator</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CAP1 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DBEAFE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>RequiereReceta</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+tipoReceta(): String</I><BR ALIGN="LEFT"/>+descripcionCorta(): String «default»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CAP2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DBEAFE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Fraccionable</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+dosisPorEnvase(): int</I><BR ALIGN="LEFT"/>+descripcionCorta(): String «default»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Base [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FEF3C7" CELLPADDING="4"><FONT POINT-SIZE="9">«abstract sealed»</FONT><BR/><I><B>Producto</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-clave: Sku<BR ALIGN="LEFT"/>-nombre: String<BR ALIGN="LEFT"/>-precioBase: double<BR ALIGN="LEFT"/>-creadoEn: LocalDateTime<BR ALIGN="LEFT"/>-cotizaciones: int «transient»<BR ALIGN="LEFT"/><U>-INSTANCIAS_CREADAS: AtomicInteger</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">#Producto(prefijo, nombre, precio)<BR ALIGN="LEFT"/>#Producto(clave, nombre, precio)<BR ALIGN="LEFT"/>+tarifa(u: int): double «final»<BR ALIGN="LEFT"/><I>#calcularTarifa(u: int): double</I><BR ALIGN="LEFT"/><I>+copiar(): Producto</I><BR ALIGN="LEFT"/>+setNombre(n: String)<BR ALIGN="LEFT"/>+setPrecioBase(p: double)<BR ALIGN="LEFT"/>+tipo(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  S1 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FEF3C7" CELLPADDING="4"><FONT POINT-SIZE="9">«static final»</FONT><BR/><B>Producto.Patente</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+PREFIJO = "PAT"</U><BR ALIGN="LEFT"/>-laboratorio: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+Patente(nombre, precio, laboratorio: String)<BR ALIGN="LEFT"/>+laboratorio(): String<BR ALIGN="LEFT"/>#calcularTarifa(u: int): double<BR ALIGN="LEFT"/>+copiar(): Patente<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  S2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FEF3C7" CELLPADDING="4"><FONT POINT-SIZE="9">«static final»</FONT><BR/><B>Producto.Generico</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+PREFIJO = "GEN"</U><BR ALIGN="LEFT"/>-concentracionMg: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+Generico(nombre, precio, concentracionMg: int)<BR ALIGN="LEFT"/>+concentracionMg(): int<BR ALIGN="LEFT"/>#calcularTarifa(u: int): double<BR ALIGN="LEFT"/>+copiar(): Generico<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  S3 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FEF3C7" CELLPADDING="4"><FONT POINT-SIZE="9">«static final»</FONT><BR/><B>Producto.Biologico</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+PREFIJO = "BIO"</U><BR ALIGN="LEFT"/>-temperaturaMax: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+Biologico(nombre, precio, temperaturaMax: int)<BR ALIGN="LEFT"/>+temperaturaMax(): int<BR ALIGN="LEFT"/>#calcularTarifa(u: int): double<BR ALIGN="LEFT"/>+copiar(): Biologico<BR ALIGN="LEFT"/>+descripcionCorta(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Clave [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DCFCE7" CELLPADDING="4"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>Sku</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">prefijo: String<BR ALIGN="LEFT"/>numero: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+siguiente(prefijo): Sku</U><BR ALIGN="LEFT"/><U>+registrar(c: Sku)</U><BR ALIGN="LEFT"/><U>+parse(texto): Sku</U><BR ALIGN="LEFT"/>+compareTo(o): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Nivel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DCFCE7" CELLPADDING="4"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Nivel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">GENERAL<BR ALIGN="LEFT"/>AFILIADO<BR ALIGN="LEFT"/>ADULTO_MAYOR<BR ALIGN="LEFT"/>-descuento: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+aplicar(monto): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Estado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DCFCE7" CELLPADDING="4"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Estado</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">ABIERTA<BR ALIGN="LEFT"/>EN_CURSO<BR ALIGN="LEFT"/>CERRADA<BR ALIGN="LEFT"/>CANCELADA<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+permiteTransicionA(d: Estado): boolean<BR ALIGN="LEFT"/>+esTerminal(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Actor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«Externalizable»</FONT><BR/><B>Cliente</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-id: int<BR ALIGN="LEFT"/>-nombre: String<BR ALIGN="LEFT"/>-correo: String<BR ALIGN="LEFT"/>-nivel: Nivel<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+Cliente()<BR ALIGN="LEFT"/>+Cliente(id, nombre, correo, nivel)<BR ALIGN="LEFT"/>+writeExternal(out)<BR ALIGN="LEFT"/>+readExternal(in)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Txn [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«Serializable, Iterable»</FONT><BR/><B>Venta</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-id: int<BR ALIGN="LEFT"/>-fecha: LocalDate<BR ALIGN="LEFT"/>-estado: Estado<BR ALIGN="LEFT"/>-lineas: List&lt;Linea&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+agregar(e: Producto, u: int): Linea «sync»<BR ALIGN="LEFT"/>+quitar(c: Sku): boolean<BR ALIGN="LEFT"/>+cambiarEstado(d: Estado) «sync»<BR ALIGN="LEFT"/>+iniciar() / cerrar() / cancelar()<BR ALIGN="LEFT"/>+subtotal(): double<BR ALIGN="LEFT"/>+total(): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Linea [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«inner final»</FONT><BR/><B>Venta.Linea</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-elemento: Producto<BR ALIGN="LEFT"/>-unidades: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-Linea(e, u)<BR ALIGN="LEFT"/>+subtotal(): double<BR ALIGN="LEFT"/>+importe(): double<BR ALIGN="LEFT"/>+contenedor(): Venta<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Cat [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«Serializable, Iterable»</FONT><BR/><B>Anaquel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-elementos: Map&lt;Sku, Producto&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+Anaquel(iniciales: Producto...)<BR ALIGN="LEFT"/>+agregar(nuevos: Producto...)<BR ALIGN="LEFT"/>+filtrar(r: Regla): List<BR ALIGN="LEFT"/>+deTipo(t: Class&lt;E&gt;): List&lt;E&gt;<BR ALIGN="LEFT"/><U>+porTarifa(u: int): Comparator «anónima»</U><BR ALIGN="LEFT"/>+resumen(): String «clase local»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Iter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«private inner»</FONT><BR/><B>Anaquel.Iterador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-cursor: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+hasNext(): boolean<BR ALIGN="LEFT"/>+next(): Producto<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Regla [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FCE7F3" CELLPADDING="4"><FONT POINT-SIZE="9">«functional interface»</FONT><BR/><B>Regla&lt;T&gt;</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+evaluar(t: T): boolean</I><BR ALIGN="LEFT"/>+y(o) / o(o) / negar() «default»<BR ALIGN="LEFT"/><U>+de(p: Predicate): Regla</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Fab [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FCE7F3" CELLPADDING="4"><FONT POINT-SIZE="9">«functional interface»</FONT><BR/><B>FabricaElemento&lt;E extends Producto, A&gt;</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+crear(nombre, precio, atributo: A): E</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RNE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«exception»</FONT><BR/><B>ReglaNegocioException</B></TD></TR></TABLE>>];
  Contrato -> Base [dir=back, arrowtail=empty, arrowhead=none, style=dashed];
  Base -> S1 [dir=back, arrowtail=empty, arrowhead=none, style=solid];
  Base -> S2 [dir=back, arrowtail=empty, arrowhead=none, style=solid];
  Base -> S3 [dir=back, arrowtail=empty, arrowhead=none, style=solid];
  CAP1 -> S1 [dir=back, arrowtail=empty, arrowhead=none, style=dashed];
  CAP2 -> S2 [dir=back, arrowtail=empty, arrowhead=none, style=dashed];
  CAP1 -> S3 [dir=back, arrowtail=empty, arrowhead=none, style=dashed];
  CAP2 -> S3 [dir=back, arrowtail=empty, arrowhead=none, style=dashed];
  Base -> S1 [dir=back, arrowtail=odot, arrowhead=none, style=solid, color="#64748B", constraint=false];
  Contrato -> Clave [arrowhead=vee, style=dashed, label=" usa", fontsize=9];
  Txn -> Linea [dir=back, arrowtail=diamond, arrowhead=none, headlabel="1..*", taillabel="1", fontsize=9, label=" «inner»", fontname="Helvetica"];
  Linea -> Base [arrowhead=vee, headlabel="1", fontsize=9];
  Txn -> Actor [arrowhead=vee, headlabel="1", fontsize=9];
  Txn -> Estado [arrowhead=vee];
  Actor -> Nivel [arrowhead=vee];
  Cat -> Base [dir=back, arrowtail=odiamond, arrowhead=none, headlabel="0..*", fontsize=9];
  Cat -> Iter [dir=back, arrowtail=odot, arrowhead=none, style=solid, color="#64748B"];
  Cat -> Regla [arrowhead=vee, style=dashed];
  Fab -> Base [arrowhead=vee, style=dashed, label=" crea", fontsize=9];
  Base -> RNE [arrowhead=vee, style=dashed, label=" lanza", fontsize=9];
}
