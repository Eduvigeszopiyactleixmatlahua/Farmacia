digraph G {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.55, fontname="Helvetica", dpi=170, bgcolor="white"];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", color="#334155"];
  UI [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#E0E7FF" CELLPADDING="4"><FONT POINT-SIZE="9">«paquete ui»</FONT><BR/><B>Capa de presentación (libre)</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">JavaFX | Swing | Spring Boot | Javalin | Vaadin | ...<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  G [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FEF3C7" CELLPADDING="4"><FONT POINT-SIZE="9">«fachada»</FONT><BR/><B>Farmacia</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+PLAZO_DIAS = 2</U><BR ALIGN="LEFT"/>-reloj: Supplier&lt;LocalDate&gt;<BR ALIGN="LEFT"/>-oyentes: List&lt;OyenteEvento&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+registrar(f: FabricaElemento&lt;E,A&gt;, ...): E<BR ALIGN="LEFT"/>+registrarCliente(...): Cliente<BR ALIGN="LEFT"/>+abrir(id): Venta<BR ALIGN="LEFT"/>+agregarLinea(id, clave, u)<BR ALIGN="LEFT"/>+iniciar/cerrar/cancelar(id)<BR ALIGN="LEFT"/>+ingresosPorTipo(): Map<BR ALIGN="LEFT"/>+masDemandado(): Optional<BR ALIGN="LEFT"/>+mejores(n): List<BR ALIGN="LEFT"/>+estadisticas(): DoubleSummaryStatistics<BR ALIGN="LEFT"/>+describir(e): String «pattern matching»<BR ALIGN="LEFT"/>+revisar(): int «sync»<BR ALIGN="LEFT"/>+iniciarMonitor(ms) / detenerMonitor()<BR ALIGN="LEFT"/>+suscribir(o: OyenteEvento)<BR ALIGN="LEFT"/>+exportarRespaldo(p: Path)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Mon [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FEF3C7" CELLPADDING="4"><FONT POINT-SIZE="9">«inner final»</FONT><BR/><B>Farmacia.MonitorSurtido</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">#ejecutarCiclo() → Farmacia.this.revisar()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Tarea [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FCE7F3" CELLPADDING="4"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>TareaPeriodica</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-periodoMs: long<BR ALIGN="LEFT"/>-activa: boolean «volatile»<BR ALIGN="LEFT"/>-hilo: Thread<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+iniciar(nombre) «sync»<BR ALIGN="LEFT"/>+detener() «interrupt + join»<BR ALIGN="LEFT"/>+run() «final»<BR ALIGN="LEFT"/><I>#ejecutarCiclo()</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Run [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DBEAFE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Runnable</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+run()</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Oy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FCE7F3" CELLPADDING="4"><FONT POINT-SIZE="9">«functional interface»</FONT><BR/><B>OyenteEvento</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+notificar(e: Evento)</I><BR ALIGN="LEFT"/>+luego(o): OyenteEvento «default»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Ev [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DCFCE7" CELLPADDING="4"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>Evento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">tipo: TipoEvento<BR ALIGN="LEFT"/>mensaje: String<BR ALIGN="LEFT"/>instante: LocalDateTime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+de(tipo, mensaje): Evento</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Repo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DBEAFE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Repositorio&lt;T, K&gt;</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+guardar(t: T)</I><BR ALIGN="LEFT"/><I>+buscar(k: K): Optional&lt;T&gt;</I><BR ALIGN="LEFT"/><I>+todos(): List&lt;T&gt;</I><BR ALIGN="LEFT"/><I>+eliminar(k: K): boolean</I><BR ALIGN="LEFT"/>+existe(k: K): boolean «default»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Map [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DBEAFE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface miembro»</FONT><BR/><B>Repositorio.MapeadorFila&lt;R&gt;</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+mapear(rs: ResultSet): R</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><B>RepositorioProductoSQLite</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>-RECONSTRUCTORES: Map</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>~atributoDe(e): String «switch sellado»</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><B>RepositorioClienteSQLite</B></TD></TR></TABLE>>];
  RT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><B>RepositorioVentaSQLite</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+guardar(t) «transacción»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Cx [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«AutoCloseable»</FONT><BR/><B>ConexionSQLite</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>-ESQUEMA: String[]</U><BR ALIGN="LEFT"/>-conexion: Connection<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">«static {}» carga org.sqlite.JDBC<BR ALIGN="LEFT"/>+enTransaccion(t: TrabajoSQL&lt;R&gt;): R<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Resp [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«utilidad»</FONT><BR/><B>Respaldo</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+exportar(path, catálogo, ...)</U><BR ALIGN="LEFT"/><U>+importar(path): Contenido</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Dom [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="9">«paquete modelo»</FONT><BR/><B>Modelo de dominio</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">Anaquel<BR ALIGN="LEFT"/>Venta<BR ALIGN="LEFT"/>Cliente<BR ALIGN="LEFT"/>Producto (+3 subtipos)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  DB [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#E2E8F0" CELLPADDING="4"><FONT POINT-SIZE="9">«base de datos»</FONT><BR/><B>SQLite (.db)</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">producto<BR ALIGN="LEFT"/>cliente<BR ALIGN="LEFT"/>venta<BR ALIGN="LEFT"/>venta_linea<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  UI -> G [arrowhead=vee, style=dashed, label=" usa", fontsize=9];
  UI -> Oy [arrowhead=vee, style=dashed, label=" implementa (lambda)", fontsize=9];
  G -> Mon [dir=back, arrowtail=odot, arrowhead=none, style=solid, color="#64748B"];
  Tarea -> Mon [dir=back, arrowtail=empty, arrowhead=none, style=solid];
  Run -> Tarea [dir=back, arrowtail=empty, arrowhead=none, style=dashed];
  G -> Oy [dir=back, arrowtail=odiamond, arrowhead=none, headlabel="0..*", fontsize=9];
  Oy -> Ev [arrowhead=vee, style=dashed];
  G -> Dom [arrowhead=vee];
  G -> Repo [arrowhead=vee, headlabel="3", fontsize=9];
  Repo -> RE [dir=back, arrowtail=empty, arrowhead=none, style=dashed];
  Repo -> RA [dir=back, arrowtail=empty, arrowhead=none, style=dashed];
  Repo -> RT [dir=back, arrowtail=empty, arrowhead=none, style=dashed];
  Repo -> Map [dir=back, arrowtail=odot, arrowhead=none, style=solid, color="#64748B"];
  RE -> Cx [arrowhead=vee];
  RA -> Cx [arrowhead=vee];
  RT -> Cx [arrowhead=vee];
  Cx -> DB [arrowhead=vee, style=dashed, label=" JDBC", fontsize=9];
  G -> Resp [arrowhead=vee, style=dashed];
}
