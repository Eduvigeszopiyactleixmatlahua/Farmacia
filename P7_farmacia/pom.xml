<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>mx.tecnm.orizaba.tp</groupId>
  <artifactId>farmacia</artifactId>
  <version>1.0.0</version>
  <name>Miniproyecto 7 - Punto de Venta y Surtido de una Farmacia</name>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <exec.mainClass>mx.tecnm.orizaba.tp.farmacia.app.PruebasModelo</exec.mainClass>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.46.1.3</version>
    </dependency>
    <!-- Ejemplo JavaFX (descomenta si eliges JavaFX):
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>21.0.5</version>
    </dependency>
    -->
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration><compilerArgs><arg>-Xlint:all,-serial</arg></compilerArgs></configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration><mainClass>${exec.mainClass}</mainClass></configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>demo</id>
      <properties><exec.mainClass>mx.tecnm.orizaba.tp.farmacia.app.DemoModelo</exec.mainClass></properties>
    </profile>
  </profiles>
</project>
